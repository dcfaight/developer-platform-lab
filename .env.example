# Copy to .env and set a nonempty, local-only password before starting Compose.
# Keep values shell-compatible if sourcing this trusted local file.
POSTGRES_DB=platform_lab
POSTGRES_USER=platform_lab
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Compose reads .env automatically; Spring Boot does not.
# After sourcing .env from the repository root (set -a; . ./.env; set +a):
# export DB_URL="jdbc:postgresql://127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}"
# export DB_USERNAME="$POSTGRES_USER"
# export DB_PASSWORD="$POSTGRES_PASSWORD"
# DB_URL defaults to jdbc:postgresql://127.0.0.1:5432/platform_lab.
# DB_USERNAME defaults to platform_lab. DB_PASSWORD is required (no default).

# Mutation accounts (see backend/README.md#authentication-and-authorization).
# Export these in the backend's shell; store only password HASHES, never passwords.
# Single-quote hashes when exporting. With no accounts, every mutation is rejected.
# export PLATFORM_SECURITY_USERS_0_USERNAME=alice
# export PLATFORM_SECURITY_USERS_0_PASSWORDHASH='{pbkdf2@SpringSecurity_v5_8}<hex>'
# export PLATFORM_SECURITY_USERS_0_ROLES=OPERATOR
# export PLATFORM_SECURITY_USERS_1_USERNAME=cleanup-bot
# export PLATFORM_SECURITY_USERS_1_PASSWORDHASH='{pbkdf2@SpringSecurity_v5_8}<hex>'
# export PLATFORM_SECURITY_USERS_1_ROLES=CLEANUP
