# Copy to .env and set a nonempty, local-only password before starting Compose.
# Keep values shell-compatible if sourcing this trusted local file.
POSTGRES_DB=platform_lab
POSTGRES_USER=platform_lab
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Compose reads .env automatically; Spring Boot does not.
# After sourcing .env from the repository root (set -a; . ./.env; set +a):
# export DB_URL="jdbc:postgresql://127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}"
# export DB_USERNAME="$POSTGRES_USER"
# export DB_PASSWORD="$POSTGRES_PASSWORD"
# DB_URL defaults to jdbc:postgresql://127.0.0.1:5432/platform_lab.
# DB_USERNAME defaults to platform_lab. DB_PASSWORD is required (no default).
